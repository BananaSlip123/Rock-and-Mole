  m_EditorClassIdentifier: 
  playerInputMapsManager: {fileID: 777192638}
  go_callOut: {fileID: 1753518846}
  scene: 0
  dialogsToShow:
  - "\xA1No hay lugar m\xE1s acogedor que el hogar!"
  - "Al volver de la mina podr\xE1s visitar la tienda y la forja."
  - "En la forja, el herrero te podr\xE1 ayudar a mejorar el pico."
  - "Un buen pico te ayuda a picar m\xE1s r\xE1pido..."
  - "\xA1Y a ser implacable contra los enemigos!"
  - "En la tienda podr\xE1s vender materiales y comprar equipamiento."
  - "Dentro del ba\xFAl podr\xE1s ver los materiales que traes de tus expediciones."
  - "Si quieres volver a bajar a la mina, solo dir\xEDgete a esa puerta de all\xED."
